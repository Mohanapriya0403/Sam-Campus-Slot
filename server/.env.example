# Copy this file to .env and fill in real values before running the server.

# MongoDB connection
# Local MongoDB:   mongodb://localhost:27017/sam_campus_slot
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>/sam_campus_slot
MONGODB_URI=mongodb://localhost:27017/sam_campus_slot

# Express
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# AI Campus Assistant chatbot (src: /api/chatbot)
# Get a key from https://console.anthropic.com — the assistant is disabled
# (returns a friendly 503) until this is set.
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# Google OAuth (Sign in with Google). Same Client ID as the frontend's
# VITE_GOOGLE_CLIENT_ID — create one at
# https://console.cloud.google.com/apis/credentials. Leave blank to disable
# the /api/auth/google endpoint (returns a friendly 503).
GOOGLE_CLIENT_ID=
